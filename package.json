{
  "name": "oneyes-comfyui",
  "productName": "OneYes ComfyUI",
  "version": "0.1.0",
  "private": true,
  "description": "ComfyUI with OneYes cloud nodes and a desktop runtime manager",
  "author": "OneYes",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Pan-chongyu/oneyes-comfyui",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "test": "node --test test-desktop/*.test.mjs",
    "test:python": "python -m unittest discover -s test-oneyes -v",
    "test:engine": "node scripts/smoke-engine.mjs",
    "pack": "electron-builder --publish never",
    "release:manifest": "node scripts/release-manifest.mjs release"
  },
  "dependencies": {
    "bsdiff-wasm": "0.1.4",
    "electron-updater": "6.8.11",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.oneyes.comfyui",
    "productName": "OneYes ComfyUI",
    "executableName": "oneyes-comfyui",
    "directories": { "output": "dist", "buildResources": "desktop/resources" },
    "files": ["desktop/**", "!desktop/engine/**", "!desktop/bin/**", "!desktop/python/**", "package.json"],
    "extraResources": [
      { "from": "desktop/engine", "to": "engine" },
      { "from": "desktop/bin", "to": "bin" },
      { "from": "LICENSE", "to": "ComfyUI-LICENSE.txt" },
      { "from": "docs", "to": "licenses", "filter": ["*-LICENSE*"] },
      { "from": "docs/THIRD_PARTY.md", "to": "THIRD_PARTY.md" }
    ],
    "artifactName": "OneYes-ComfyUI-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis"], "icon": "desktop/resources/icon.ico", "artifactName": "OneYes-ComfyUI-${version}-Windows-${arch}-Setup.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "shortcutName": "OneYes ComfyUI" },
    "mac": { "target": ["dmg", "zip"], "icon": "desktop/resources/icon.icns", "identity": "-", "hardenedRuntime": false, "gatekeeperAssess": false, "category": "public.app-category.graphics-design", "artifactName": "OneYes-ComfyUI-${version}-macOS-${arch}.${ext}", "extendInfo": { "CFBundleDisplayName": "OneYes ComfyUI" } },
    "linux": { "target": ["AppImage", "deb", "rpm"], "icon": "desktop/resources/icon.png", "category": "Graphics", "maintainer": "OneYes <support@oneyes.ai>", "artifactName": "OneYes-ComfyUI-${version}-Linux-${arch}.${ext}" },
    "publish": null
  }
}
