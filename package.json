{
  "name": "oneyes-comfyui",
  "productName": "OneYes ComfyUI",
  "version": "0.1.19",
  "private": true,
  "description": "ComfyUI with integrated OneYes accounts and cloud nodes",
  "author": "OneYes",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Pan-chongyu/oneyes-comfyui",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "test": "node --test test-desktop/*.test.mjs",
    "test:account-ui": "node scripts/test-account-ui.mjs",
    "test:python": "python -m unittest discover -s test-oneyes -v",
    "test:engine": "node scripts/smoke-engine.mjs",
    "pack": "electron-builder --publish never",
    "release:blockmaps": "node scripts/prepare-ota-blockmaps.mjs dist",
    "release:manifest": "node scripts/release-manifest.mjs release"
  },
  "dependencies": {
    "bsdiff-wasm": "0.1.4",
    "electron-updater": "6.8.11",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.oneyes.comfyui",
    "beforePack": "scripts/normalize-resources.cjs",
    "productName": "OneYes ComfyUI",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/**",
      "!desktop/engine/**",
      "!desktop/bin/**",
      "!desktop/python/**",
      "!desktop/frontend/**",
      "!desktop/frontend-src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/frontend",
        "to": "frontend"
      },
      {
        "from": "desktop/engine",
        "to": "engine"
      },
      {
        "from": "desktop/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/comfyui_frontend_package/static{,/**}",
          "!**/comfy_kitchen/backends/{cuda,hip}/_C*.{pyd,so}"
        ]
      },
      {
        "from": "LICENSE",
        "to": "ComfyUI-LICENSE.txt"
      },
      {
        "from": "docs",
        "to": "licenses",
        "filter": [
          "*-LICENSE*"
        ]
      },
      {
        "from": "docs/THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "artifactName": "OneYes-ComfyUI-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/resources/icon.ico",
      "artifactName": "OneYes-ComfyUI-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "OneYes ComfyUI"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/resources/icon.icns",
      "identity": "-",
      "sign": "scripts/sign-macos.cjs",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.graphics-design",
      "artifactName": "OneYes-ComfyUI-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "OneYes ComfyUI"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "executableName": "oneyes-comfyui",
      "icon": "desktop/resources/icon.png",
      "category": "Graphics",
      "maintainer": "OneYes <support@oneyes.ai>",
      "artifactName": "OneYes-ComfyUI-${version}-Linux-${arch}.${ext}"
    },
    "publish": null
  }
}
