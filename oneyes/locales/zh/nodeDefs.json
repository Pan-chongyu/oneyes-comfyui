    "inputs": { "model": { "name": "模型" }, "prompt": { "name": "提示词" }, "size": { "name": "尺寸" }, "quality": { "name": "质量" }, "seed": { "name": "任务种子" }, "control_after_generate": { "name": "生成后控制" } },
    "outputs": { "0": { "name": "图片" }, "1": { "name": "本地任务编号" } }
  },
